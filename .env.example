# Copy this file to .env.local and fill in real values there. Never commit a filled-in copy —
# .env.local is gitignored, this file (.env.example) is not.
#
# packages/catalog, @cfm/import and @cfm/scanner need none of these — they are deliberately
# dependency-free so the evaluator runs from a script or a test without booting anything.

# Only needed to run scripts/smoke-anthropic.ts (npm run smoke:anthropic -- --confirm), which is
# the one script in this repo permitted to spend real money. Everything else — npm test, npm run
# smoke, npm run scanner:preview — runs with no key at all.
#
# Get one at https://platform.claude.com (Settings > API keys). Set a spend limit there too
# (Settings > Billing) — that account-level cap is the real ceiling; the $1 cap in
# scripts/smoke-anthropic.ts is a second, local one for catching a mistake during development.
ANTHROPIC_API_KEY=

# Used by apps/scanner's production build only (npm run scanner:build). Leave unset for
# npm run scanner:preview, which is what you want while nothing is published yet.
CONTROLLER_NAME=
CONTROLLER_ADDRESS=
CONTACT_EMAIL=
WAITLIST_ACTION=
