# Public by design: the browser needs both to reach Supabase, and they grant nothing beyond what
# row-level security allows (supabase/migrations/). Never put a secret key in any VITE_ variable —
# the build refuses a bundle containing one (vite.config.ts).
VITE_SUPABASE_URL=https://qsqhcithnqanqzvsfyez.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_1JvNMT7TnLR-I41uX8wjFg_Dz-XoOe1
# Who stands behind the service, shown on /privacy and /dpa (D-053). Already public on the
# scanner's privacy notice. The postal address is optional (D-043 §5): unset, the pages offer it
# on request. The sign-in email sender must be one src/legal/senders.ts describes.
VITE_CONTROLLER_NAME=Tabeen Raoof
VITE_CONTACT_EMAIL=attestacompliance@gmail.com
VITE_AUTH_EMAIL_SENDER=supabase
