# Copy to .env.local (gitignored) for `npm run dev`. Both values are public by design: the
# publishable key only grants what row-level security allows (supabase/migrations/). Never put
# the service-role key or any server secret here — anything VITE_-prefixed ships to the browser,
# and the build fails if a known secret pattern reaches the bundle (vite.config.ts).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Shown on the privacy policy and DPA (src/legal/). A production build refuses without the name,
# email and sender; the address is optional. Sender must be listed in src/legal/senders.ts.
VITE_CONTROLLER_NAME=
VITE_CONTACT_EMAIL=
VITE_CONTROLLER_ADDRESS=
VITE_AUTH_EMAIL_SENDER=supabase
